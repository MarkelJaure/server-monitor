# Broker MQTT
MQTT_BROKER=broker.example.com
MQTT_PORT=1883
# Si el broker requiere autenticación, descomentá y completá estas líneas.
MQTT_USER=tu_usuario
MQTT_PASSWORD="tu_contraseña"

# Usá el tópico completo con true. Para agregar el hostname automáticamente,
# usá MQTT_SERVER=clients/mi-cliente e IS_FINAL_DEVICE=false.
MQTT_SERVER=clients/mi-cliente/mi-equipo
IS_FINAL_DEVICE=true

# Usá false para deshabilitar las acciones remotas por MQTT.
ALLOW_ACTIONS=true

# Usá true si el equipo no necesita monitorear máquinas virtuales de Hyper-V.
SKIP_VMS=false

# Usá preview en las PCs donde quieras recibir versiones preliminares.
UPDATE_CHANNEL=stable

# Usá DEBUG en servidores si necesitás el detalle de cada publicación.
LOG_LEVEL=INFO
# Tamaño máximo aproximado por archivo en MiB. Con 0 se desactiva la rotación.
LOG_MAX_MB=20
# Cantidad de archivos rotados que se conservan por proceso.
LOG_BACKUP_COUNT=3
