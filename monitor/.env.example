# Broker MQTT
MQTT_BROKER=broker.example.com
MQTT_PORT=1883
MQTT_USER=tu_usuario
MQTT_PASSWORD="tu_contraseña"

# Dispositivo publicado
MQTT_SERVER=clients/mi-cliente/mi-equipo
IS_FINAL_DEVICE=true # true = el tópico incluye el cliente final, false = utiliza el hostname para completar el dispositivo

# Configuraciones del server
ALLOW_ACTIONS=true # false = deshabilitar las acciones remotas por MQTT.
SKIP_VMS=false # true = equipo no necesita monitorear máquinas virtuales.
UPDATE_CHANNEL=stable # preview = recibir versiones preliminares.

# Logging
LOG_LEVEL=INFO
LOG_MAX_MB=20 # 0 = desactivar la rotación.
LOG_BACKUP_COUNT=3
